<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Módulo de Operaciones de Despachantes</title>
    <style>
        :root {
            --primary: #2563eb;
            --secondary: #1e40af;
            --success: #16a34a;
            --danger: #dc2626;
            --light: #f8fafc;
            --dark: #1e293b;
            --border: #cbd5e1;
            --warning: #d97706;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #e2e8f0;
            margin: 0;
            padding: 20px;
            color: var(--dark);
        }
        .container {
            max-width: 1400px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        h1, h2, h3 { color: var(--dark); margin-top: 0; }
        
        /* Panel de Tarifas */
        .tarifas-panel {
            background: #fff7ed;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 30px;
        }
        .tarifas-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 15px;
        }
        .tarifa-item {
            display: flex;
            flex-direction: column;
            background: white;
            padding: 10px;
            border-radius: 6px;
            border: 1px solid var(--border);
        }
        .tarifa-item label { font-size: 0.85rem; margin-bottom: 5px; }
        .tarifa-inputs { display: flex; gap: 5px; }
        .tarifa-inputs input { width: 70%; }
        .tarifa-inputs select { width: 30%; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }
        .form-group { display: flex; flex-direction: column; }
        label { font-weight: 600; margin-bottom: 5px; font-size: 0.9rem; }
        input, select {
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 1rem;
        }
        input:focus, select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
        }
        .botonera { display: flex; gap: 15px; margin-bottom: 20px; }
        .btn {
            border: none;
            padding: 12px 20px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: bold;
            transition: 0.2s;
        }
        .btn-calcular { background: var(--primary); color: white; }
        .btn-calcular:hover { background: var(--secondary); }
        .btn-exportar { background: var(--success); color: white; }
        .btn-exportar:hover { background: #15803d; }
        
        .tabla-container { overflow-x: auto; margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th { background: var(--dark); color: white; padding: 12px; text-align: left; }
        td { padding: 10px 12px; border-bottom: 1px solid var(--border); white-space: nowrap; }
        tr:nth-child(even) { background: var(--light); }
        .badge { padding: 4px 8px; border-radius: 12px; font-size: 0.75rem; font-weight: bold; }
        .badge-rojo { background: #fee2e2; color: #991b1b; }
        .badge-naranja { background: #ffedd5; color: #9a3412; }
        .badge-verde { background: #dcfce7; color: #166534; }

        .summary-cards { display: flex; gap: 20px; margin-bottom: 20px; }
        .card { flex: 1; background: var(--light); padding: 15px; border-radius: 8px; text-align: center; }
        .card h3 { font-size: 1rem; color: #64748b; margin: 0 0 5px 0;}
        .card p { font-size: 1.8rem; font-weight: bold; margin: 0; color: var(--primary); }
        .text-success { color: var(--success); font-weight: bold; }
        .text-danger { color: var(--danger); }
    </style>
</head>
<body>

<div class="container">
    <h1>📊 Módulo de Operaciones de Despachantes</h1>
    
    <!-- PANEL DE TARIFAS CONFIGURABLES -->
    <div class="tarifas-panel">
        <h3 style="margin-top:0; color:var(--warning)">⚙️ Configuración de Tarifas (Modificable)</h3>
        <p style="font-size: 0.9rem; margin-top:0;">Cambiá los precios y la moneda según el despachante. Si cobrás en USD, se multiplicará por el TC. Si cobrás en ARS, se suma directo al Neto.</p>
        <div class="tarifas-grid">
            <div class="tarifa-item">
                <label>Base Verde / Naranja</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_base_vn" value="17" step="0.01">
                    <select id="moneda_base_vn"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Base Rojo</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_base_r" value="20" step="0.01">
                    <select id="moneda_base_r"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Armado de Sobre</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_sobre" value="4" step="0.01">
                    <select id="moneda_sobre"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Camión AD (V/N)</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_cam_vn" value="5" step="0.01">
                    <select id="moneda_cam_vn"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Camión AD (Rojo)</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_cam_r" value="6" step="0.01">
                    <select id="moneda_cam_r"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Senasa Pallets</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_senasa_p" value="2" step="0.01">
                    <select id="moneda_senasa_p"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Senasa Producto</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_senasa_pr" value="3" step="0.01">
                    <select id="moneda_senasa_pr"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Hojas Adic. (c/u)</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_hojas" value="0.15" step="0.01">
                    <select id="moneda_hojas"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>MIC</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_mic" value="5" step="0.01">
                    <select id="moneda_mic"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Foja AD (c/u)</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_fojas" value="2" step="0.01">
                    <select id="moneda_fojas"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Multinotas (c/u)</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_multinota" value="2" step="0.01">
                    <select id="moneda_multinota"><option value="USD">USD</option><option value="ARS">ARS</option></select>
                </div>
            </div>
            <div class="tarifa-item">
                <label>Toma de Contenedor</label>
                <div class="tarifa-inputs">
                    <input type="number" id="precio_toma" value="200" step="0.01">
                    <select id="moneda_toma"><option value="ARS">ARS</option><option value="USD">USD</option></select>
                </div>
            </div>
        </div>
    </div>

    <div class="form-grid">
        <div class="form-group">
            <label>Cliente / Despachante</label>
            <input type="text" id="cliente" placeholder="Ej: ENVACO">
        </div>
        <div class="form-group">
            <label>Destinación</label>
            <input type="text" id="destinacion" placeholder="Ej: IC03 1251N">
        </div>
        <div class="form-group">
            <label>Canal</label>
            <select id="canal">
                <option value="V">Verde (V)</option>
                <option value="N">Naranja (N)</option>
                <option value="R">Rojo (R)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Frecuencia de Cobro</label>
            <select id="frecuencia">
                <option value="Diario">Diario</option>
                <option value="Semanal">Semanal</option>
                <option value="Mensual">Mensual</option>
            </select>
        </div>
        <div class="form-group">
            <label>Tipo de Cambio (PE)</label>
            <input type="number" id="tc" value="1400" step="0.01">
        </div>
    </div>

    <h3>Servicios de la Operación</h3>
    <div class="form-grid">
        <div class="form-group">
            <label>Armado de Sobre (Cant)</label>
            <input type="number" id="sobre" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Cant. Camiones AD</label>
            <input type="number" id="camiones" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Senasa Pallets (Cant)</label>
            <input type="number" id="senasaP" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Senasa Producto (Cant)</label>
            <input type="number" id="senasaPr" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Hojas Adic. (Cant)</label>
            <input type="number" id="hojas" value="0" min="0">
        </div>
        <div class="form-group">
            <label>MIC (Cant)</label>
            <input type="number" id="mic" value="0" min="0">
        </div>
        <div class="form-group">
            <label>N° de MIC</label>
            <input type="text" id="numMic" placeholder="Ej: 26AR225103A">
        </div>
        <div class="form-group">
            <label>Fojas AD (Cant)</label>
            <input type="number" id="fojas" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Multinotas (Cant)</label>
            <input type="number" id="multinotas" value="0" min="0">
        </div>
        <div class="form-group">
            <label>N° de Multinota</label>
            <input type="text" id="numMultinota" placeholder="Ej: MULTINOTA 295">
        </div>
        <div class="form-group">
            <label>Toma de Contenedor (Cant)</label>
            <input type="number" id="tomaCont" value="0" min="0">
        </div>
        <div class="form-group">
            <label>Otros Adicionales (ARS $)</label>
            <input type="number" id="adicArs" value="0" step="0.01">
        </div>
    </div>

    <div class="botonera">
        <button class="btn btn-calcular" onclick="calcularYGuardar()">+ Calcular y Cargar Operación</button>
        <button class="btn btn-exportar" onclick="exportarExcel()">📄 Exportar a Excel</button>
    </div>

    <hr style="margin: 30px 0; border: 0; border-top: 1px solid var(--border);">

    <div class="summary-cards">
        <div class="card">
            <h3>Operaciones Cargadas</h3>
            <p id="totalOps">0</p>
        </div>
        <div class="card">
            <h3>Total USD Generado</h3>
            <p id="totalUsdGenerado">$0.00</p>
        </div>
        <div class="card">
            <h3>Total Bruto ARS</h3>
            <p id="totalArsGenerado">$0.00</p>
        </div>
    </div>

    <div class="tabla-container">
        <table id="tablaDatos">
            <thead>
                <tr>
                    <th>N° Op</th>
                    <th>Cliente</th>
                    <th>Dest.</th>
                    <th>Canal</th>
                    <th>N° MIC</th>
                    <th>N° Multinota</th>
                    <th>Cobro</th>
                    <th>Total USD</th>
                    <th>Valor ARS</th>
                    <th>Neto ARS</th>
                    <th>IVA ARS</th>
                    <th>Bruto ARS</th>
                </tr>
            </thead>
            <tbody id="tablaOperaciones"></tbody>
        </table>
    </div>
</div>

<script>
    let operaciones = [];
    let contadorOp = 1;

    // Helper para leer precios del panel de configuración
    function getTarifa(idBase) {
        let precio = parseFloat(document.getElementById('precio_' + idBase).value) || 0;
        let moneda = document.getElementById('moneda_' + idBase).value;
        return { precio, moneda };
    }

    // Helper para calcular item
    function calcItem(qty, idBase, canal, tc) {
        if(qty <= 0) return { usd: 0, ars: 0 };
        
        // Si es tarifa que depende de canal (base y camiones)
        let idCompleto = idBase;
        if(idBase === 'base') idCompleto = (canal === 'R') ? 'base_r' : 'base_vn';
        if(idBase === 'cam') idCompleto = (canal === 'R') ? 'cam_r' : 'cam_vn';

        let { precio, moneda } = getTarifa(idCompleto);
        
        if(moneda === 'USD') return { usd: qty * precio, ars: 0 };
        return { usd: 0, ars: qty * precio };
    }

    function calcularYGuardar() {
        let cliente = document.getElementById('cliente').value || "S/N";
        let destinacion = document.getElementById('destinacion').value || "S/D";
        let canal = document.getElementById('canal').value;
        let frecuencia = document.getElementById('frecuencia').value;
        let tc = parseFloat(document.getElementById('tc').value);
        let numMic = document.getElementById('numMic').value || "-";
        let numMultinota = document.getElementById('numMultinota').value || "-";
        
        let qtySobre = parseInt(document.getElementById('sobre').value) || 0;
        let qtyCamiones = parseInt(document.getElementById('camiones').value) || 0;
        let qtySenasaP = parseInt(document.getElementById('senasaP').value) || 0;
        let qtySenasaPr = parseInt(document.getElementById('senasaPr').value) || 0;
        let qtyHojas = parseInt(document.getElementById('hojas').value) || 0;
        let qtyMic = parseInt(document.getElementById('mic').value) || 0;
        let qtyFojas = parseInt(document.getElementById('fojas').value) || 0;
        let qtyMultinotas = parseInt(document.getElementById('multinotas').value) || 0;
        let qtyToma = parseInt(document.getElementById('tomaCont').value) || 0;
        let adicArs = parseFloat(document.getElementById('adicArs').value) || 0;

        let totalUsd = 0;
        let totalArsDirecto = 0;

        // Calcular cada ítem
        let r1 = calcItem(1, 'base', canal, tc); totalUsd += r1.usd; totalArsDirecto += r1.ars;
        let r2 = calcItem(qtySobre, 'sobre', canal, tc); totalUsd += r2.usd; totalArsDirecto += r2.ars;
        let r3 = calcItem(qtyCamiones, 'cam', canal, tc); totalUsd += r3.usd; totalArsDirecto += r3.ars;
        let r4 = calcItem(qtySenasaP, 'senasa_p', canal, tc); totalUsd += r4.usd; totalArsDirecto += r4.ars;
        let r5 = calcItem(qtySenasaPr, 'senasa_pr', canal, tc); totalUsd += r5.usd; totalArsDirecto += r5.ars;
        let r6 = calcItem(qtyHojas, 'hojas', canal, tc); totalUsd += r6.usd; totalArsDirecto += r6.ars;
        let r7 = calcItem(qtyMic, 'mic', canal, tc); totalUsd += r7.usd; totalArsDirecto += r7.ars;
        let r8 = calcItem(qtyFojas, 'fojas', canal, tc); totalUsd += r8.usd; totalArsDirecto += r8.ars;
        let r9 = calcItem(qtyMultinotas, 'multinota', canal, tc); totalUsd += r9.usd; totalArsDirecto += r9.ars;
        let r10 = calcItem(qtyToma, 'toma', canal, tc); totalUsd += r10.usd; totalArsDirecto += r10.ars;

        // Sumar adicionales manuales en ARS
        totalArsDirecto += adicArs;

        // Cálculos finales
        let valorArs = totalUsd * tc;          // USD pasados a pesos
        let netoArs = valorArs + totalArsDirecto; // Valor en pesos + servicios en ARS directos
        let ivaArs = netoArs * 0.21;           
        let brutoArs = netoArs + ivaArs;       

        let fecha = new Date();
        let anio = fecha.getFullYear();
        let mes = String(fecha.getMonth() + 1).padStart(2, '0');
        let nOp = `OP-${anio}-${mes}-${String(contadorOp).padStart(3, '0')}`;
        contadorOp++;

        operaciones.push({
            nOp, cliente, destinacion, canal, numMic, numMultinota, frecuencia, 
            totalUsd, valorArs, netoArs, ivaArs, brutoArs
        });

        renderTabla();
        limpiarFormulario();
    }

    function renderTabla() {
        let tbody = document.getElementById('tablaOperaciones');
        tbody.innerHTML = '';
        
        let totalUsdAcum = 0;
        let totalArsAcum = 0;

        operaciones.forEach(op => {
            let canalClass = op.canal === 'R' ? 'badge-rojo' : (op.canal === 'N' ? 'badge-naranja' : 'badge-verde');

            let tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${op.nOp}</strong></td>
                <td>${op.cliente}</td>
                <td>${op.destinacion}</td>
                <td><span class="badge ${canalClass}">${op.canal}</span></td>
                <td>${op.numMic}</td>
                <td>${op.numMultinota}</td>
                <td>${op.frecuencia}</td>
                <td>$${op.totalUsd.toFixed(2)}</td>
                <td>$${op.valorArs.toFixed(2)}</td>
                <td>$${op.netoArs.toFixed(2)}</td>
                <td class="text-danger">$${op.ivaArs.toFixed(2)}</td>
                <td class="text-success">$${op.brutoArs.toFixed(2)}</td>
            `;
            tbody.appendChild(tr);

            totalUsdAcum += op.totalUsd;
            totalArsAcum += op.brutoArs;
        });

        document.getElementById('totalOps').innerText = operaciones.length;
        document.getElementById('totalUsdGenerado').innerText = `$${totalUsdAcum.toFixed(2)}`;
        document.getElementById('totalArsGenerado').innerText = `$${totalArsAcum.toFixed(2)}`;
    }

    function limpiarFormulario() {
        document.getElementById('cliente').value = '';
        document.getElementById('destinacion').value = '';
        document.getElementById('numMic').value = '';
        document.getElementById('numMultinota').value = '';
        document.getElementById('sobre').value = 0;
        document.getElementById('camiones').value = 0;
        document.getElementById('senasaP').value = 0;
        document.getElementById('senasaPr').value = 0;
        document.getElementById('hojas').value = 0;
        document.getElementById('mic').value = 0;
        document.getElementById('fojas').value = 0;
        document.getElementById('multinotas').value = 0;
        document.getElementById('tomaCont').value = 0;
        document.getElementById('adicArs').value = 0;
    }

    function exportarExcel() {
        if (operaciones.length === 0) {
            alert("No hay operaciones cargadas para exportar.");
            return;
        }

        let htmlTabla = `
            <table border="1">
                <thead>
                    <tr style="background-color: #1e293b; color: white; font-weight: bold;">
                        <th>N° Op</th>
                        <th>Cliente</th>
                        <th>Destinación</th>
                        <th>Canal</th>
                        <th>N° MIC</th>
                        <th>N° Multinota</th>
                        <th>Frecuencia</th>
                        <th>Total USD</th>
                        <th>Valor ARS</th>
                        <th>Neto ARS</th>
                        <th>IVA ARS</th>
                        <th>Bruto ARS</th>
                    </tr>
                </thead>
                <tbody>
        `;

        operaciones.forEach(op => {
            htmlTabla += `
                <tr>
                    <td>${op.nOp}</td>
                    <td>${op.cliente}</td>
                    <td>${op.destinacion}</td>
                    <td>${op.canal}</td>
                    <td>${op.numMic}</td>
                    <td>${op.numMultinota}</td>
                    <td>${op.frecuencia}</td>
                    <td style="text-align: right;">${op.totalUsd.toFixed(2)}</td>
                    <td style="text-align: right;">${op.valorArs.toFixed(2)}</td>
                    <td style="text-align: right;">${op.netoArs.toFixed(2)}</td>
                    <td style="text-align: right;">${op.ivaArs.toFixed(2)}</td>
                    <td style="text-align: right; font-weight: bold;">${op.brutoArs.toFixed(2)}</td>
                </tr>
            `;
        });

        htmlTabla += `</tbody></table>`;

        let blob = new Blob(['\ufeff', htmlTabla], { type: 'application/vnd.ms-excel' });
        let url = URL.createObjectURL(blob);
        let a = document.createElement('a');
        a.href = url;
        
        let fecha = new Date();
        let nombreArchivo = `Operaciones_Despachantes_${fecha.getDate()}-${fecha.getMonth() + 1}-${fecha.getFullYear()}.xls`;
        
        a.download = nombreArchivo;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }
</script>

</body>
</html>
